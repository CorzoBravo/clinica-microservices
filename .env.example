# ==========================================
# Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y define tus propios valores
# ==========================================

# Base de datos PostgreSQL
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=tu_password_segura_aqui
POSTGRES_DB=clinica_db

# Seguridad JWT
# En producción genera una clave criptográfica (ej. openssl rand -base64 32)
JWT_SECRET=tu_jwt_secret_seguro_aqui

# Entorno de ejecución (development | production)
NODE_ENV=production
